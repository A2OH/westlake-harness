{
  "description": "How each NDK library is supplied on OpenHarmony under 'package AOSP, weld the bottom' (analysis/AOSP-PACKAGING-STRATEGY.md). A missing NDK symbol takes its library's strategy unless a family rule matches first. 'source' paths are relative to the AOSP imports root and are checked against Westlake's native build manifests.",
  "groups": {
    "package": "AOSP source compiled inside Westlake; no OpenHarmony subsystem underneath beyond what Westlake already provides",
    "libc-abi": "bionic ABI translated onto musl in the bionic-ABI shim; Android's libc cannot share a process with OH's musl",
    "weld": "AOSP source above, an OpenHarmony subsystem below: the weld is the work",
    "gpu-driver": "OpenHarmony's GPU driver answers (never ship AOSP's EGL/GLES/Vulkan loaders); missing names are Android extensions",
    "use-oh": "OpenHarmony ships an equivalent library",
    "cxx-runtime": "C++ runtime entry points, provided by libc++ (OH's, or the app's libc++_shared)",
    "truthful-absence": "legacy, deprecated or rare: report 'not available' the way a device without it does"
  },
  "welds": {
    "buffers":  {"oh": "graphic_surface / native_buffer", "effort": "M"},
    "window":   {"oh": "window_manager + render_service", "effort": "M"},
    "sync":     {"oh": "Linux sync_file (same kernel)", "effort": "XS"},
    "audio":    {"oh": "audio_framework (OHAudio)", "effort": "M"},
    "input":    {"oh": "multimodalinput", "effort": "M"},
    "sensors":  {"oh": "sensors", "effort": "M"},
    "power":    {"oh": "powermgr / thermal_manager", "effort": "S"},
    "media":    {"oh": "multimedia/av_codec + player_framework", "effort": "L"},
    "camera":   {"oh": "multimedia/camera_framework", "effort": "L"},
    "log":      {"oh": "hilog", "effort": "XS"},
    "services": {"oh": "samgr", "effort": "M"}
  },
  "libraries": {
    "libc.so":   {"group": "libc-abi", "note": "fortify wrappers, bionic-private names, resolver internals, fdsan, system properties, GNU extras"},
    "libm.so":   {"group": "libc-abi"},
    "libdl.so":  {"group": "libc-abi", "note": "android_dlopen_ext and target-SDK queries belong to the Westlake loader"},
    "libstdc++.so": {"group": "cxx-runtime"},
    "liblog.so": {"group": "weld", "weld": "log", "source": "logging/liblog"},
    "libz.so":   {"group": "use-oh"},
    "libnativehelper.so": {"group": "package", "source": "libnativehelper"},
    "libicu.so": {"group": "package", "source": "icu/libicu", "note": "unversioned C API over the ICU Westlake already builds"},
    "libsync.so": {"group": "weld", "weld": "sync", "source": "system-core/libsync"},
    "libbinder_ndk.so": {"group": "weld", "weld": "services", "source": "frameworks-native/libs/binder/ndk", "note": "Westlake welds it to OH samgr (oh_service_manager.cpp)"},
    "libjnigraphics.so": {"group": "package", "source": "frameworks-base/native/graphics/jni", "note": "AImageDecoder over the Skia codecs Westlake already builds"},
    "libnativewindow.so": {"group": "weld", "weld": "buffers", "source": "frameworks-native/libs/nativewindow",
      "families": [{"match": "^ANativeWindow", "group": "weld", "weld": "window"}]},
    "libEGL.so": {"group": "gpu-driver",
      "families": [{"match": "ANDROID$", "group": "weld", "weld": "buffers"},
                   {"match": "NV$", "group": "truthful-absence"}]},
    "libGLESv1_CM.so": {"group": "gpu-driver", "missing_group": "truthful-absence",
      "note": "fixed-function GLES 1.x is absent from the OH driver; emulate over GLES 2/3 only if an app needs it"},
    "libGLESv2.so": {"group": "gpu-driver"},
    "libGLESv3.so": {"group": "gpu-driver"},
    "libvulkan.so": {"group": "gpu-driver",
      "families": [{"match": "AndroidSurface", "group": "weld", "weld": "window"},
                   {"match": "AndroidHardwareBuffer", "group": "weld", "weld": "buffers"}]},
    "libOpenSLES.so": {"group": "use-oh", "missing_group": "weld", "weld": "audio",
      "note": "OH ships OpenSL ES without Android's extensions; AOSP source (frameworks/wilhelm) is not yet imported",
      "families": [{"match": "^SL_IID_ANDROID", "group": "weld", "weld": "audio"}]},
    "libOpenMAXAL.so": {"group": "truthful-absence", "note": "deprecated"},
    "libaaudio.so": {"group": "weld", "weld": "audio", "source": "frameworks-av/media/libaaudio"},
    "libamidi.so": {"group": "truthful-absence", "source": "frameworks-base/media/native/midi"},
    "libneuralnetworks.so": {"group": "truthful-absence", "note": "NNAPI is deprecated from Android 15; report no accelerator"},
    "libcamera2ndk.so": {"group": "weld", "weld": "camera", "source": "frameworks-av/camera/ndk"},
    "libmediandk.so": {"group": "weld", "weld": "media", "source": "frameworks-av/media/ndk",
      "families": [{"match": "^AImage", "group": "weld", "weld": "buffers"}]},
    "libandroid.so": {"group": "package", "source": "frameworks-base/native/android",
      "families": [
        {"match": "^(AAsset|AAssetDir|AAssetManager)_", "group": "package", "source": "frameworks-base/native/android/asset_manager.cpp"},
        {"match": "^ALooper_", "group": "package", "source": "frameworks-base/native/android/looper.cpp"},
        {"match": "^AConfiguration_", "group": "package", "source": "frameworks-base/native/android/configuration.cpp"},
        {"match": "^(AFont|AFontMatcher|ASystemFontIterator)_", "group": "package", "source": "frameworks-base/native/android/system_fonts.cpp"},
        {"match": "^ASharedMemory_", "group": "package", "source": "frameworks-base/native/android/sharedmem.cpp"},
        {"match": "^ATrace_", "group": "package", "source": "frameworks-base/native/android/trace.cpp"},
        {"match": "^(AStorageManager|AObbInfo|AObbScanner)_", "group": "package", "source": "frameworks-base/native/android/storage_manager.cpp"},
        {"match": "^APermissionManager_", "group": "package", "source": "frameworks-base/native/android/permission_manager.cpp"},
        {"match": "^AActivityManager_", "group": "package", "source": "frameworks-base/native/android/activity_manager.cpp"},
        {"match": "^android_", "group": "package", "source": "frameworks-base/native/android/net.c"},
        {"match": "^AChoreographer", "group": "weld", "weld": "window", "source": "frameworks-base/native/android/choreographer.cpp"},
        {"match": "^(AMotionEvent|AKeyEvent|AInputEvent|AInputQueue)_", "group": "weld", "weld": "input", "source": "frameworks-base/native/android/input.cpp"},
        {"match": "^ANativeActivity_", "group": "weld", "weld": "input", "source": "frameworks-base/native/android/native_activity.cpp"},
        {"match": "^ANativeWindow_", "group": "weld", "weld": "window", "source": "frameworks-base/native/android/native_window_jni.cpp"},
        {"match": "^(ASurfaceControl|ASurfaceTransaction|ASurfaceTransactionStats)_", "group": "weld", "weld": "window", "source": "frameworks-base/native/android/surface_control.cpp"},
        {"match": "^ASurfaceTexture_", "group": "weld", "weld": "buffers", "source": "frameworks-base/native/android/surface_texture.cpp"},
        {"match": "^AHardwareBuffer_", "group": "weld", "weld": "buffers", "source": "frameworks-base/native/android/hardware_buffer_jni.cpp"},
        {"match": "^(ASensor|ASensorManager|ASensorEventQueue|ASensorEvent)_", "group": "weld", "weld": "sensors", "source": "frameworks-base/native/android/sensor.cpp"},
        {"match": "^(APerformanceHint|AWorkDuration)", "group": "weld", "weld": "power", "source": "frameworks-base/native/android/performance_hint.cpp"},
        {"match": "^AThermal_", "group": "weld", "weld": "power", "source": "frameworks-base/native/android/thermal.cpp"}
      ]}
  }
}
